# Where decision records, runs and model usage are stored.
# Leave this unset to use the project's own SQLite file (data/flywheel.db) --
# that is what the CLIs, the MCP server, the tests and the course demo expect,
# and it needs no database running.
# Set it to point the same code at Postgres (see docker-compose.yml):
# FLYWHEEL_DATABASE_URL=postgresql+psycopg://flywheel:flywheel@localhost:5432/flywheel
FLYWHEEL_DATABASE_URL=
