# Model provider (console.groq.com/keys). Every agent uses it.
GROQ_API_KEY=

# Where decision records, runs and model usage are stored.
# Leave this unset to use the project's own SQLite file (data/flywheel.db) --
# that is what the CLIs, the tests and a local demo expect, and it needs no
# database running. Set it to point the same code at Postgres; a hosted
# provider's plain postgresql:// address works as it is.
# FLYWHEEL_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
FLYWHEEL_DATABASE_URL=

# --- Langfuse tracing of every model call (off unless both keys are set) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://us.cloud.langfuse.com   # or https://cloud.langfuse.com (EU)

# --- Hosted deployment only ---
# A shared code the API requires on every request (the website asks for it).
# FLYWHEEL_ACCESS_CODE=
# Where the website is served from, for CORS (comma separated).
# FLYWHEEL_CORS_ORIGINS=https://your-site.vercel.app
# Plans one client address may start per hour (default 30).
# FLYWHEEL_RUNS_PER_HOUR=30

# --- Switches (all default to on / auto) ---
# FLYWHEEL_A2A=off          # run the execution agents in-process instead of over A2A
# FLYWHEEL_A2A_URL=         # where the A2A agents are served (default: this API's /a2a)
# FLYWHEEL_MCP_TOOLS=off    # call the tools directly instead of through the MCP server
# FLYWHEEL_TRACE=0          # silence the live agent trace in the terminal
# FLYWHEEL_LLM_CACHE=0      # do not reuse saved model answers
